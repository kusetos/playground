# PostgreSQL Primary
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=mydatabase

# PostgreSQL Replica
PGUSER=myuser
PGPASSWORD=mysecretpassword
REPLICATION_PASSWORD=replpass

# Connection URLs
DATABASE_URL=postgres://myuser:mysecretpassword@localhost:5432/mydatabase
DATABASE_REPLICA_URL=postgres://myuser:mysecretpassword@localhost:5433/mydatabase
DATABASE_SHARD_0_URL=postgres://myuser:mysecretpassword@localhost:5434/mydatabase
DATABASE_SHARD_1_URL=postgres://myuser:mysecretpassword@localhost:5435/mydatabase
